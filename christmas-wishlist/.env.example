# Copy to .env.local, or run `npm run env:local` to fill it from the local stack.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Fallback site URL for invite links and auth redirects. The app normally uses
# the request's own host, so this only matters outside a request.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" once Google sign-in is configured in Supabase.
NEXT_PUBLIC_GOOGLE_SIGN_IN=false
# Never add the service role key here. The app doesn't use it.
