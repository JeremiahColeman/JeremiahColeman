# Copy to .env.local. For local development, values come from `npx supabase status`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public site URL, used to build invite links and auth redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Never add the service role key here. The app doesn't use it.
